{
  "name": "bookmarked",
  "description": "A tiny (dependency free!) library for building bookmark files.",
  "version": "3.0.9",
  "author": "Ollie Williams",
  "bugs": "https://github.com/pxlprfct/bookmarked/issues",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "publint": "^0.3.25",
    "syncpack": "15.3.3",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/pxlprfct/bookmarked#readme",
  "keywords": [
    "bookmark",
    "chrome",
    "firefox",
    "safari"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "packageManager": "pnpm@10.33.0",
  "repository": "pxlprfct/bookmarked.git",
  "scripts": {
    "prepare": "husky",
    "build": "tsdown",
    "changeset": "changeset",
    "dev": "vitest",
    "exports": "attw --pack .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "changeset version && changeset publish",
    "syncpack:format": "syncpack format",
    "syncpack:update": "syncpack update",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:coverage:run": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "tsc": "tsc",
    "watch": "tsdown --watch",
    "knip": "VITE_CJS_IGNORE_WARNING=true knip"
  },
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
