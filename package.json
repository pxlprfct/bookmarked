{
  "name": "bookmarked",
  "description": "A tiny (dependency free!) library for building bookmark files.",
  "version": "3.0.9",
  "author": "Ollie Williams",
  "bugs": "https://github.com/pxlprfct/bookmarked/issues",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "fallow": "^3.33.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "^1.88.0",
    "prettier": "3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/pxlprfct/bookmarked#readme",
  "keywords": [
    "bookmark",
    "chrome",
    "firefox",
    "safari"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "packageManager": "pnpm@10.33.0",
  "repository": "pxlprfct/bookmarked.git",
  "scripts": {
    "prepare": "husky",
    "build": "tsdown",
    "changeset": "changeset",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsc",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "exports": "attw --pack . --profile node16",
    "deadcode": "fallow dead-code",
    "verify": "pnpm format && pnpm lint && pnpm tsc && pnpm test:coverage && pnpm build && pnpm exports && pnpm deadcode",
    "release": "changeset publish",
    "dev": "vitest",
    "watch": "tsdown --watch"
  },
  "type": "module",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
