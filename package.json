{
  "name": "bookmarked",
  "description": "A tiny (dependency free!) library for building bookmark files.",
  "version": "4.0.0",
  "author": "Ollie Williams <ollie@makework.studio>",
  "bugs": "https://github.com/pxlprfct/bookmarked/issues",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "fallow": "3.33.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/pxlprfct/bookmarked#readme",
  "keywords": [
    "bookmark",
    "bookmarks",
    "netscape",
    "html",
    "export",
    "chrome",
    "firefox",
    "safari",
    "edge",
    "typescript"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "packageManager": "pnpm@10.33.0",
  "repository": "pxlprfct/bookmarked.git",
  "scripts": {
    "prepare": "husky",
    "build": "tsdown",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsc",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "exports": "attw --pack .",
    "deadcode": "fallow dead-code",
    "verify": "pnpm format && pnpm lint && pnpm tsc && pnpm test:coverage && pnpm build && pnpm exports && pnpm deadcode",
    "dev": "vitest",
    "watch": "tsdown --watch",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "type": "module",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.14.0"
    }
  }
}
